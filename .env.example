# Copy to .env and fill in. .env is git-ignored.

# Bot (composer + replies)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna

# Production host only (leave unset locally):
# VERA_CACHE_MODE=memory      nothing persists to disk; /v1/teardown wipes the runtime cache
# VERA_SPEND_CAP_USD=1.50     hard stop on LLM spend for this deployment
# TEAM_NAME=  TEAM_MEMBERS=a,b  CONTACT_EMAIL=  SUBMITTED_AT=2026-..Z

# Local judge (judge_simulator.py); LLM_API_KEY falls back to OPENAI_API_KEY
BOT_URL=http://127.0.0.1:8080
LLM_PROVIDER=openai
LLM_API_KEY=
